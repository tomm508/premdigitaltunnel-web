{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with balance, email and role",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 128 },
        "balance": { "type": "number" },
        "role": { "type": "string", "enum": ["member", "admin"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "balance"]
    },
    "TopupOrder": {
      "title": "TopupOrder",
      "description": "Topup deposit balance request",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["pending", "completed", "cancelled"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "amount", "status"]
    },
    "UserSshAccount": {
      "title": "UserSshAccount",
      "description": "Saved SSH tunnel accounts created by user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "serverName": { "type": "string", "maxLength": 64 },
        "host": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 64 },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "username", "host"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile with balance"
    },
    "/users/{userId}/topups/{topupId}": {
      "schema": "TopupOrder",
      "description": "Topup requests for specific user"
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": "UserSshAccount",
      "description": "Generated accounts saved in user history"
    }
  }
}
